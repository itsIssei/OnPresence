# All settings are optional. See docs/configuration.md.

# Public address, used for link previews and canonical URLs.
# PUBLIC_URL=https://example.com

# Domain for deploy/traefik and deploy/caddy.
# DOMAIN=example.com

# Traefik only (deploy/traefik/compose.yaml).
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT_HTTP=web
# TRAEFIK_ENTRYPOINT_HTTPS=websecure
# CERT_RESOLVER=letsencrypt

# Admin account. Leave empty to create it in the browser on first start
# (the setup code is printed in the logs). Only used while no admin exists.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Forgot your password? Set ADMIN_PASSWORD plus ADMIN_RESET_PASSWORD=1,
# restart once, then remove both. This also turns off 2FA.
# ADMIN_RESET_PASSWORD=

# Reverse proxies allowed to set X-Forwarded-For (comma-separated CIDRs).
# TRUSTED_PROXIES=

# Sessions and backups.
# SESSION_TTL=168h
# BACKUP_KEEP=7
